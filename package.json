{
  "name": "technical-interview-frontend",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:mock": "vite --host 127.0.0.1 --mode mock",
    "dev:mock:managed": "node scripts/dev-mock-managed.mjs",
    "dev:list": "node scripts/dev-server-processes.mjs list",
    "dev:cleanup": "node scripts/dev-server-processes.mjs cleanup",
    "build": "tsc -b && vite build",
    "docker:build": "docker build -t technical-interview-frontend .",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "npm run lint:markdown && npm run lint:eslint",
    "lint:eslint": "eslint .",
    "lint:markdown": "node scripts/check-markdown-line-endings.mjs && node scripts/check-mermaid-markdown.mjs && markdownlint-cli2",
    "format:markdown": "node scripts/format-markdown.mjs",
    "audit:security": "npm audit --audit-level=high",
    "a11y": "node scripts/a11y.mjs",
    "hardening:m20": "npm run hardening:runtime && npm run hardening:kube-linter && npm run hardening:trivy",
    "hardening:bundle-budget": "node scripts/check-bundle-budget.mjs",
    "hardening:runtime": "node scripts/check-runtime-nginx.mjs",
    "hardening:sbom": "node scripts/generate-release-sbom.mjs",
    "hardening:kube-linter": "node scripts/check-rendered-manifests.mjs",
    "hardening:trivy": "node scripts/run-trivy-image-scan.mjs",
    "smoke:anonymous": "node scripts/smoke-anonymous.mjs",
    "smoke:authenticated": "node scripts/smoke-authenticated-mock.mjs",
    "typecheck": "npm run api:types:check && tsc -b --pretty false",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "api:types": "node scripts/generate-openapi-types.mjs",
    "api:types:check": "node scripts/generate-openapi-types.mjs --check"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.17.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@codecov/bundler-plugin-core": "^2.0.1",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "markdownlint-cli2": "^0.22.1",
    "mermaid": "^11.15.0",
    "playwright": "^1.61.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
